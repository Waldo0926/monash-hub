# China mainland read-only deployment environment (Tencent Cloud Guangzhou).
# Copy to .env.cn on the server and replace placeholder secrets before starting.
#
#   cp .env.cn.example .env.cn
#   POSTGRES_PASSWORD=$(openssl rand -hex 20)
#   SECRET_KEY=$(openssl rand -hex 32)

# --- Database -----------------------------------------------------------
POSTGRES_USER=monashhub_cn
POSTGRES_DB=monashhub_cn
POSTGRES_PASSWORD=change-me-strong-password

# --- API & Read-only Switch ---------------------------------------------
ENVIRONMENT=production
CN_READONLY_MODE=true
SECRET_KEY=change-me-openssl-rand-hex-32
CURRENT_ACADEMIC_YEAR=2026

# During ICP review, preview happens over SSH port-forwarding on 127.0.0.1:18080.
# After ICP approval, switch SITE_URL to https://mumguide.cn and enable HTTPS nginx.
SITE_URL=https://mumguide.cn
CORS_ORIGINS=https://mumguide.cn,http://127.0.0.1:18080
TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12

# --- Loopback-only host ports (NEVER expose publicly) -------------------
CN_API_PORT=18100
CN_WEB_PORT=18101

# Optional: git commit SHA recorded in /api/health
APP_COMMIT=
