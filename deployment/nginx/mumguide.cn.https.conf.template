# HTTPS Nginx template for mumguide.cn (China mainland read-only site).
#
# WARNING: DO NOT ENABLE BEFORE ICP FILING IS APPROVED AND DNS IS POINTED.
#
# Activation steps AFTER ICP approval:
#   1. Point mumguide.cn (and www.mumguide.cn if desired) A record to 175.178.176.51.
#   2. Issue SSL certificate (e.g. certbot certonly --webroot or Tencent Cloud SSL)
#      and place fullchain.pem / privkey.pem at the paths below.
#   3. Copy this file to /etc/nginx/sites-available/mumguide.cn and create symlink:
#        sudo ln -s /etc/nginx/sites-available/mumguide.cn /etc/nginx/sites-enabled/mumguide.cn
#   4. Update /opt/monash-hub-cn/.env.cn (SITE_URL=https://mumguide.cn) if needed.
#   5. Run `sudo nginx -t && sudo systemctl reload nginx`.

server {
    listen 80;
    listen [::]:80;
    server_name mumguide.cn www.mumguide.cn;

    # ACME HTTP-01 challenge path for Let's Encrypt / certbot renewals.
    location ^~ /.well-known/acme-challenge/ {
        allow all;
        root /var/www/html;
    }

    location / {
        return 301 https://mumguide.cn$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.mumguide.cn;

    ssl_certificate     /etc/letsencrypt/live/mumguide.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mumguide.cn/privkey.pem;

    return 301 https://mumguide.cn$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mumguide.cn;

    access_log /var/log/nginx/mumguide.cn.access.log;
    error_log  /var/log/nginx/mumguide.cn.error.log;

    ssl_certificate     /etc/letsencrypt/live/mumguide.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mumguide.cn/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security headers.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 1m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # Disabled UGC / avatar / auth / community / ask endpoints (defense in depth).
    location ^~ /avatars/ {
        return 404;
    }

    # Nuxt content-hashed assets: cache aggressively to save 3M origin bandwidth.
    location ^~ /_nuxt/ {
        proxy_pass http://127.0.0.1:18101;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Static public assets (icons, images, manifest).
    location ~* \.(?:png|jpg|jpeg|gif|webp|svg|ico|woff2?|ttf|webmanifest)$ {
        proxy_pass http://127.0.0.1:18101;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=604800" always;
    }

    # Read-only FastAPI backend (loopback only).
    location /api/ {
        proxy_pass http://127.0.0.1:18100;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Read-only Nuxt SSR frontend (loopback only).
    location / {
        proxy_pass http://127.0.0.1:18101;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
