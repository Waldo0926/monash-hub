# Copy to .env and fill in. Never commit the real file.
#
#   cp .env.example .env
#   POSTGRES_PASSWORD=$(openssl rand -base64 24)
#   SECRET_KEY=$(openssl rand -hex 32)

# --- Database -----------------------------------------------------------
POSTGRES_USER=monashhub
POSTGRES_DB=monashhub
POSTGRES_PASSWORD=change-me

# --- API ----------------------------------------------------------------
ENVIRONMENT=production
# Signs session tokens. Rotating it signs everyone out, which is the point.
SECRET_KEY=change-me-openssl-rand-hex-32
CURRENT_ACADEMIC_YEAR=2026
CORS_ORIGINS=https://monashhub.secureview.tech

# --- Public site --------------------------------------------------------
SITE_URL=https://monashhub.secureview.tech

# --- Host ports (loopback only; nginx is what faces the internet) --------
API_PORT=8100
WEB_PORT=8101

# --- Email -------------------------------------------------------------
# Registration and password reset both send a six-digit code, so without a
# working provider nobody outside the server can create an account.
#   console  development only - the code goes to the API log, not to an inbox
#   resend   set RESEND_API_KEY
#   smtp     set SMTP_HOST and the rest
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@monashhub.secureview.tech
EMAIL_FROM_NAME=Monash Hub
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# --- Optional: create the first moderator account -----------------------
# Only used by `python -m app.knowledge.seed`. Leave unset to skip.
# ADMIN_EMAIL=
# ADMIN_NICKNAME=
# ADMIN_PASSWORD=
